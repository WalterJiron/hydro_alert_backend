# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seismic_events
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DATABASE_URL=postgresql+asyncpg://admin:change-me@db:5432/seismic_events

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# INETER scraping
INETER_URL=https://webserver2.ineter.gob.ni/geofisica/sis/events/sismos.php
INETER_TIMEOUT_SECONDS=25
INETER_POLL_INTERVAL_SECONDS=120
INETER_RETRIES=3
INETER_RETRY_BACKOFF_SECONDS=1.5
INETER_VERIFY_TLS=true
# INETER serves an incomplete TLS chain (missing Sectigo intermediate CA).
# This optional PEM bundle is added to the default certifi trust store.
INETER_CA_BUNDLE=certs/sectigo-public-server-authentication-ca-ov-r36.pem
INETER_MAX_RESPONSE_BYTES=5242880
SYNC_ENABLED=true
SYNC_ADVISORY_LOCK_KEY=8102026

# WebSocket
WS_INITIAL_EVENTS=30
WS_MAX_CONNECTIONS=200
WS_MAX_REPLAY_EVENTS=500
WS_NOTIFICATION_REPLAY_SECONDS=300

# Reporter authentication
AUTH_REGISTER_RATE_LIMIT=10
AUTH_LOGIN_RATE_LIMIT=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Community reports
REPORTS_MAX_ACTIVE=100
REPORT_PHOTO_MAX_BYTES=5242880
# Optional absolute base used to build photoUrl. Include /api/v1.
# PUBLIC_API_BASE_URL=https://api.ejemplo.com/api/v1

# Supabase Storage (S3 / REST API) for community report photos
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-secret-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_BUCKET=Imagenes
SUPABASE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# Emergency notifications generated from newly detected strong earthquakes
EMERGENCY_NOTIFICATIONS_ENABLED=true
EMERGENCY_MIN_MAGNITUDE=5.0
EMERGENCY_MAX_EVENT_AGE_SECONDS=1800

